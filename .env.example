SERVER_PORT=5000

# relative sqlite-Pfade landen im instance/-Ordner der API
SQLALCHEMY_DATABASE_URI=sqlite:///boulder-ai.db
# generieren mit: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me

# Erkennung
WEIGHTS_PATH=./weights/best.pt
DETECT_CONF=0.4
USE_SAM=1
SAM_WEIGHTS=sam2.1_b.pt

# Video: stabile Zwei-Pass-Pipeline; legacy nur fuer A/B-Diagnosen
VIDEO_PIPELINE=two_pass
VIDEO_MAX_SECONDS=60
VIDEO_STRIDE=2
VIDEO_KEYFRAME=20
VIDEO_MASK_CANDIDATES=3
VIDEO_TRACK_PATIENCE=30
VIDEO_TEMPORAL_IOU=0.12
VIDEO_FADE_FRAMES=5
# VIDEO_DEVICE=cpu

# nur für scripts/prepare_dataset.py (kostenloser Account, Settings -> API Key)
ROBOFLOW_API_KEY=
